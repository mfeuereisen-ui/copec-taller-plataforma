{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Copec Taller Protocol",
  "description": "Schema canónico de un protocolo de seguridad operacional",
  "type": "object",
  "required": ["code", "version", "lastUpdated", "title", "category", "criticality", "service", "objective", "scope", "procedure"],
  "properties": {
    "code": { "type": "string", "pattern": "^P[1-3]-[0-9]{2}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "lastUpdated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 5 },
    "shortTitle": { "type": "string" },
    "category": { "type": "string", "enum": ["P1", "P2", "P3"] },
    "criticality": { "type": "string", "enum": ["alto-riesgo", "medio", "bajo"] },
    "service": {
      "type": "array",
      "items": { "type": "string", "enum": ["estacion", "movil", "ambos"] },
      "minItems": 1
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "icon": { "type": "string" },
    "alertBanner": { "type": "string" },
    "objective": { "type": "string", "minLength": 10 },
    "scope": { "type": "string", "minLength": 10 },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["alta", "media", "baja"] },
          "family": { "type": "string" }
        }
      }
    },
    "responsibles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "duty"],
        "properties": {
          "role": { "type": "string" },
          "duty": { "type": "string" }
        }
      }
    },
    "epp": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "type": "string" },
          "obligatory": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "verification": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "normatives": { "type": "array", "items": { "type": ["string", "object"] } },
    "procedure": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "title"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["action", "decision", "alert", "end"] },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "description": { "type": "string" },
              "duration": { "type": "string" },
              "criticalAlerts": { "type": "array", "items": { "type": "string" } },
              "verifications": { "type": "array", "items": { "type": "string" } },
              "next": { "type": "array", "items": { "type": "string" } },
              "yes": { "type": "string" },
              "no": { "type": "string" },
              "yesLabel": { "type": "string" },
              "noLabel": { "type": "string" },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "next"],
                  "properties": {
                    "label": { "type": "string" },
                    "next": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "stopRules": { "type": "array", "items": { "type": "string" } },
    "emergencyActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["situation", "action"],
        "properties": {
          "situation": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "linkedAnnexes": { "type": "array", "items": { "type": "string" } },
    "linkedProtocols": { "type": "array", "items": { "type": "string" } },
    "registry": { "type": "array", "items": { "type": "string" } },
    "customQuestions": {
      "type": "array",
      "description": "Preguntas autoría manual opcionales para el modo capacitación",
      "items": {
        "type": "object",
        "required": ["question", "options"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["single-choice", "multi-choice"] },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "correctIndex": { "type": "integer" },
          "correctIndices": { "type": "array", "items": { "type": "integer" } },
          "explanation": { "type": "string" }
        }
      }
    }
  }
}
